{
    "name": "teris-dev/erecht24-bundle",
    "description": "Symfony bundle for automatic push & pull of eRecht24 legal texts (imprint, privacy policy) – single site or multi-tenant.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "erecht24", "impressum", "datenschutz", "imprint", "privacy-policy", "legal"],
    "require": {
        "php": ">=8.2",
        "psr/cache": "^2.0 || ^3.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher-contracts": "^3.5",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/twig-bundle": "Provides the erecht24_document() Twig function for the built-in document store."
    },
    "autoload": {
        "psr-4": { "Teris\\ERecht24Bundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Teris\\ERecht24Bundle\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --exclude-group live",
        "test:live": "phpunit --group live",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
